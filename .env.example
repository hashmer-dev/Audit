# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# API_KEY or OPENROUTER_API_KEY: Required for OpenRouter AI API calls (nvidia/nemotron-3.5-lightning:free, etc.)
API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: The URL where this app is hosted (e.g. your Vercel deployment URL).
APP_URL="https://my-app.vercel.app"

