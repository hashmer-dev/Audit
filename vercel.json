{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/audit/analyze",
      "destination": "/api/audit/analyze"
    },
    {
      "source": "/api/audit/editor-ai",
      "destination": "/api/audit/editor-ai"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
